      "model_retry_delay_ms": {
        "default": 100,
        "maximum": 60000,
        "minimum": 0,
        "title": "Model Retry Delay Ms",
        "type": "integer"
      },
      "model_retry_max_delay_ms": {
        "default": 60000,
        "maximum": 3600000,
        "minimum": 0,
        "title": "Model Retry Max Delay Ms",

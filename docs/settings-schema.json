      },
      "objective": {
        "minLength": 1,
        "title": "Objective",
        "type": "string"
      },
      "output_directory": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Output Directory"
      },
      "prepare_repository": {
        "default": false,
        "title": "Prepare Repository",
        "type": "boolean"
      },
      "prerequisite_checks": {
        "items": {
          "$ref": "#/$defs/Check"
        },
        "title": "Prerequisite Checks",
        "type": "array"
      },
      "progress_monitor": {
        "$ref": "#/$defs/ProgressMonitor"
      },
      "repository": {
        "title": "Repository",

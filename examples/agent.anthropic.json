{
  "repository": "../../your-target-repository",
  "state_directory": "../.polyinference/anthropic-run",
  "objective": "Describe the bounded coding objective here.",
  "allowed_write_paths": [
    "src/example.py"
  ],
  "closure_paths": [
    "src/example.py",
    "pyproject.toml"
  ],
  "checks": [
    {
      "name": "tests",
      "argv": [
        "python3",
        "-m",
        "pytest",
        "-q"
      ],
      "timeout_seconds": 120
    }
  ],
  "check_execution": "trusted",
  "local": {
    "protocol": "anthropic",
    "base_url": "https://api.anthropic.com/v1",
    "model": "claude-haiku-5-5",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_inflight": 2
  },
  "cloud": {
    "protocol": "anthropic",
    "base_url": "https://api.anthropic.com/v1",
    "model": "claude-haiku-5-5",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_inflight": 1
  }
}

{
  "system": {
    "repository": "../../your-target-repository",
    "state_directory": "../.polyinference/gemini-run",
    "allowed_write_paths": [
      "src/example.py"
    ],
    "closure_paths": [
      "src/example.py",
      "pyproject.toml"
    ],
    "checks": [
      {
        "name": "tests",
        "argv": [
          "python3",
          "-m",
          "pytest",
          "-q"
        ],
        "timeout_seconds": 120
      }
    ],
    "local": {
      "protocol": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "model": "YOUR_WORKER_MODEL",
      "api_key_env": "GEMINI_API_KEY",
      "max_inflight": 2,
      "lifecycle": {
        "transport": "buffered",
        "connect_seconds": 10,
        "first_output_seconds": 180,
        "idle_seconds": 90,
        "total_seconds": 600
      }
    },
    "cloud": {
      "protocol": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "model": "YOUR_SENIOR_MODEL",
      "api_key_env": "GEMINI_API_KEY",
      "max_inflight": 1,
      "lifecycle": {
        "transport": "buffered",
        "connect_seconds": 10,
        "first_output_seconds": 180,
        "idle_seconds": 90,
        "total_seconds": 600
      }
    },
    "check_execution": "trusted",
    "context_policy": {
      "auto_deal_context": true,
      "auto_compaction": false
    }
  },
  "objective": "Describe the bounded coding objective here.",
  "inference_policy": {
    "additional_retries": 1,
    "replace_undelivered": true
  },
  "model_output_target_tokens": 4096
}
